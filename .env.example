# Required: powers the AI tester
ANTHROPIC_API_KEY=sk-ant-...

# ---------------- Payments ----------------
# Every test costs a USD amount paid in your project's token.
# Your token's contract address (mint):
# PAYMENT_TOKEN_MINT=
# The wallet that receives payments (your treasury wallet's address):
# PAYMENT_WALLET=
# Price per test in USD (default 0.50). Optional per-mode overrides below.
# PRICE_USD=0.50
# PRICE_USD_FAST=0.50
# PRICE_USD_PROBE=0.50
# PRICE_USD_BUILD=0.50
# Payments are OFF for now (tests are free). Remove this line once your
# token is launched and PAYMENT_TOKEN_MINT / PAYMENT_WALLET are set.
PAYMENTS_DISABLED=1

# ---------------- Strongly recommended ----------------
# GitHub token (no scopes needed): unlocks GitHub code search for finding
# unlinked repos, and raises API limits. github.com/settings/tokens
# GITHUB_TOKEN=ghp_...
# Private Solana RPC (a free Helius key works); used to price and verify payments.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...
# Brave Search API key (free tier) for reliable web search; otherwise DuckDuckGo.
# BRAVE_API_KEY=...

# ---------------- AI cost controls ----------------
# Each mode has its own model, thinking budget, tool-call budget and a hard
# cost cap per run (in USD). Defaults:
#   fast:  claude-sonnet-5-5, no thinking,   14 tool calls, max $0.30
#   probe: claude-sonnet-5-5, 2048 thinking, 32 tool calls, max $1.00
#   build: claude-sonnet-5-5, 2048 thinking, 55 tool calls, max $2.00
# Override any of them, e.g.:
# PROBE_MODEL=claude-opus-5-5
# PROBE_THINKING=4000
# PROBE_MAX_TOOL_CALLS=40
# PROBE_MAX_COST_USD=1.50
# BUILD_MAX_COST_USD=3.00

# Browser: auto-detects Chrome / Edge / Brave / Chromium. Set if yours isn't found.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ---------------- Production / public server ----------------
# Listen on all interfaces (needed on a server; the Dockerfile sets this).
# HOST=0.0.0.0
# PORT=3001
# Tests running at the same time (1 on a 512 MB free instance).
# MAX_CONCURRENT=2
